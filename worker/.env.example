# =============================================================================
# SISTEMA
# =============================================================================
AIRFLOW_UID=50000

# =============================================================================
# WORKER CONFIG
# Cambiar por cada worker:
#   worker-1 → <IP_WORKER_1>
# =============================================================================
CELERY_HOSTNAME=worker-1
QUEUES=celery,default
WORKER_CONCURRENCY=2

# =============================================================================
# BASE DE DATOS — PostgreSQL externo Sirius
# =============================================================================
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>

# Conexión externa adicional
AIRFLOW_CONN_MY_POSTGRES_DB=postgresql://<DB_EXTERNAL_USER>:<DB_EXTERNAL_PASSWORD>@<DB_EXTERNAL_HOST>:<DB_EXTERNAL_PORT>/<DB_EXTERNAL_NAME>

# =============================================================================
# CELERY — RabbitMQ Sirius
# =============================================================================
AIRFLOW__CELERY__BROKER_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@<RABBITMQ_HOST>:<RABBITMQ_PORT>/

# =============================================================================
# SEGURIDAD — iguales al master
# =============================================================================
AIRFLOW__CORE__FERNET_KEY=<GENERATED_FERNET_KEY>
AIRFLOW__API__SECRET_KEY=<GENERATED_SECRET_KEY>
AIRFLOW__API_AUTH__JWT_SECRET=<GENERATED_JWT_SECRET>
AIRFLOW__API_AUTH__JWT_ISSUER=https://<YOUR_DOMAIN>/execution/
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:<ADMIN_PASSWORD>

# =============================================================================
# EXECUTION API — Master Sirius
# =============================================================================
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://<MASTER_AIRFLOW_IP>:<PORT>/execution/

# =============================================================================
# GIT SYNC
# =============================================================================
GIT_REPO_URL=https://github.com/<YOUR_ORGANIZATION_OR_USER>/<YOUR_REPO>
GIT_BRANCH=main
GIT_SYNC_PERIOD=60s


# =============================================================================
# PIP EXTRAS
# =============================================================================
_PIP_ADDITIONAL_REQUIREMENTS=

# =============================================================================
# Configuración de Paths e Intervalos del Worker
# =============================================================================
AIRFLOWDAG_PROCESSORREFRESH_INTERVAL=5
AIRFLOW__CELERY__WORKER_CONCURRENCY=2
PYTHONPATH=/opt/airflow/dags/current/pipelines
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags/current/pipelines/dags

# ─── Spark cross-account ──────────────────────────────────────────────────────
SPARK_ROLE_ARN=arn:aws:iam::<AWS_ACCOUNT_ID>:role/<ROLE_NAME>
SPARK_REGION=us-east-2
SPARK_MASTER_IP=<SPARK_MASTER_IP>
SSH_KEY_PATH=/opt/airflow/.ssh/key-master-spark.pem
SSH_USER=ubuntu
STOP_DELAY_SECONDS=300
S3_SCRIPT_KEY=tlc/jobs/transformacion.py

# ─── Airflow API Credentials ──────────────────────────────────────────────────
AIRFLOW_API_URL=http://<MASTER_AIRFLOW_IP>:<PORT>
AIRFLOW_API_USER=admin
AIRFLOW_API_PASS=<ADMIN_PASSWORD>

# ─── Worker Performance & Stability ───────────────────────────────────────────
AIRFLOW__CORE__WORKER_HEARTBEAT_SEC=30
AIRFLOW__CELERY__WORKER_HEARTBEAT=30
AIRFLOW__CELERY__WORKER_MAX_TASKS_PER_CHILD=50