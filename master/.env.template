AIRFLOW_UID=50000

# -----------------------------------------------------------------------------
# Base de datos — PostgreSQL externo Sirius
# -----------------------------------------------------------------------------
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>

# -----------------------------------------------------------------------------
# Broker — RabbitMQ
# -----------------------------------------------------------------------------
AIRFLOW__CELERY__BROKER_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@<RABBITMQ_HOST>:<RABBITMQ_PORT>/

# -----------------------------------------------------------------------------
# Seguridad Airflow
# -----------------------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=<GENERATED_FERNET_KEY>
AIRFLOW__API__SECRET_KEY=<GENERATED_SECRET_KEY>
AIRFLOW__API_AUTH__JWT_SECRET=<GENERATED_JWT_SECRET>
AIRFLOW__API_AUTH__JWT_ISSUER=https://<YOUR_DOMAIN>/execution/
AIRFLOW__API__BASE_URL=https://<YOUR_DOMAIN>

# -----------------------------------------------------------------------------
# Execution API
# -----------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://<EXECUTION_API_HOST>:<PORT>/execution/

# -----------------------------------------------------------------------------
# Usuario admin (Formato -> usuario:contraseña,usuario2:contraseña2)
# -----------------------------------------------------------------------------
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:<ADMIN_PASSWORD>,reino_vegetal:<VEGETAL_PASSWORD>,reino_animal:<ANIMAL_PASSWORD>,reino_monera:<MONERA_PASSWORD>,reino_fungi:<FUNGI_PASSWORD>

# -----------------------------------------------------------------------------
# Compose profiles
# -----------------------------------------------------------------------------
COMPOSE_PROFILES=flower

# -----------------------------------------------------------------------------
# Git Sync
# -----------------------------------------------------------------------------
GIT_REPO_URL=https://github.com/<YOUR_ORGANIZATION_OR_USER>/<YOUR_REPO>
GIT_BRANCH=main
GIT_DAG_SUBPATH=pipelines/dags
GIT_SYNC_PERIOD=60s

# -----------------------------------------------------------------------------
# Pip extras
# -----------------------------------------------------------------------------
_PIP_ADDITIONAL_REQUIREMENTS=

# -----------------------------------------------------------------------------
# Configuración de Intervalos y Paths
# -----------------------------------------------------------------------------
AIRFLOWDAG_PROCESSORREFRESH_INTERVAL=5
PYTHONPATH=/opt/airflow/pipelines

# ─── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET=<S3_DATA_BUCKET_NAME>
S3_SCRIPT_KEY=tlc/jobs/transformacion.py
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# ─── Optimizaciones de Base de Datos ──────────────────────────────────────────
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_SIZE=20
AIRFLOW__DATABASE__SQL_ALCHEMY_MAX_OVERFLOW=20
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_TIMEOUT=60

# ─── Sesión / JWT ─────────────────────────────────────────────────────────────
AIRFLOW__API_AUTH__JWT_EXPIRATION_TIME=86400